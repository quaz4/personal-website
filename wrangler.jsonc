{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": false,
  },
  "assets": {
    "directory": "_site",
  },
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
}
